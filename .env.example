# ==========================================================================
# Tallyora — variáveis de ambiente locais
# Copie para .env e preencha. NUNCA versione o .env preenchido.
#   cp .env.example .env
# ==========================================================================

# --- Ambiente --------------------------------------------------------------
# dev = SQLite (padrão, sem instalar banco)   |   prd = PostgreSQL
APP_ENV=dev

# --- Django ---------------------------------------------------------------
# Gere uma chave só sua:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-esta-chave
# Se omitido, DEBUG é True em dev e False em prd.
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Cotações (opcional) ---------------------------------------------------
# A carteira já cota pela API oficial da B3, que não pede chave.
# Token gratuito do brapi.dev só é usado como fonte extra de fallback.
BRAPI_TOKEN=

# --- Google Calendar (opcional, espelho dos lembretes) ---------------------
# Sem as três chaves o app funciona 100% com lembretes manuais.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- PostgreSQL (só usado quando APP_ENV=prd) ------------------------------
DB_NAME=tallyora
DB_USER=tallyora
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
